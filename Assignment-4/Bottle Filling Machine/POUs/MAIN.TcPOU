<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="MAIN" Id="{c64c315e-42ea-46d0-b038-de9d06b9360d}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
    fbMachine : FB_BottleFillingMachine;  
    imachine   : I_Machine; 
	eSelectMode : E_MachineMode;         

	bRunOnce : BOOL;       
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[WHILE GVL_IO.g_eMode = E_MachineMode.none DO
	GVL_IO.g_sStatusofMachine := 'Select any Mode';
	bRunOnce := True;
END_WHILE

IF bRunONce THEN
	imachine := fbMachine;
	eSelectMode := GVL_IO.g_eMode;
	fbmachine.SelectMode(eSelectedMode := eSelectMode);
	brunOnce := FALSE;
END_IF


imachine.Execute();

]]></ST>
    </Implementation>
