      </Set>
    </Property>
    <Property Name="IsHealthy" Id="{75a15961-ecc4-448d-aa76-e1a91217bcb8}">
      <Declaration><![CDATA[{warning 'add property implementation'}
PROPERTY IsHealthy : BOOL
]]></Declaration>
      <Get Name="Get" Id="{0d2f4cc3-b834-48b1-84dc-f6caaae3d824}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsHealthy := NOT (bTempAlarm OR bHumidityAlarm);]]></ST>
        </Implementation>
      </Get>
      <Set Name="Set" Id="{06b2d659-7fe9-4246-a401-3d2ce647a8da}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[]]></ST>
        </Implementation>
      </Set>
    </Property>
    <Method Name="Reset" Id="{802c6792-29c9-4c00-b818-743f601e83a8}">
      <Declaration><![CDATA[{warning 'add method implementation '}
METHOD Reset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[bCoolingON     := FALSE;
bHeatingON     := FALSE;
bTempAlarm     := FALSE;
bHumidityAlarm := FALSE;
sStatusMessage := 'Zone C: Reset complete';
Reset := TRUE;]]></ST>
      </Implementation>
    </Method>
