    <Method Name="Reset" Id="{ac59811e-04f4-4d51-8ec7-95db1987ccd4}">
      <Declaration><![CDATA[{warning 'add method implementation '}
METHOD Reset : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[sLastQuarantined := '';
sStatusMessage   := 'Zone D: Reset complete';
Reset := TRUE;]]></ST>
      </Implementation>
