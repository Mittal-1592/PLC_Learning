<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <POU Name="FB_QuarantineHandler" Id="{8ffae50b-3f2e-4bb4-b4ec-3fe59dc2d26b}" SpecialFunc="None">
    <Declaration><![CDATA[(*
  FB_QuarantineHandler
  --------------------
  Implements: I_Zone
  Responsibility: Zone D — Automatic isolation of unsafe batches.

  Runs EVERY scan cycle.
  Scans all batch records for EXPIRED or RECALLED status.
  For each found:
  1. Changes status to QUARANTINED
  2. Changes zone to ZONE_QUARANTINE
  3. Frees the rack slot (so healthy batches can use it)
  4. Sets quarantine alarm

  NOTE: Once quarantined, a batch can only be removed by
  a maintenance operator — not by the automatic system.
*)
FUNCTION_BLOCK FB_QuarantineHandler IMPLEMENTS I_Zone
VAR_INPUT
    bEnable         : BOOL;
    dtNow           : DATE_AND_TIME;
END_VAR

VAR_OUTPUT
    nQuarantineCount    : INT;          // Total batches currently in Zone D
    bQuarantineAlarm    : BOOL;         // TRUE if any batch in quarantine
    sLastQuarantined    : STRING(20);   // ID of most recently quarantined batch
    sStatusMessage      : STRING(80);
END_VAR

VAR
    i               : INT;
    bNewQuarantine  : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="Execute" Id="{c5487576-60ba-452c-84b6-e46effada16c}">
      <Declaration><![CDATA[{warning 'add method implementation '}
METHOD Execute : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nQuarantineCount := 0;
bNewQuarantine   := FALSE;

FOR i := 1 TO GVL_Config.C_MAX_BATCHES DO

    IF NOT GVL_MedicineDB.astBatches[i].bIsOccupied THEN
        CONTINUE;
    END_IF

    // Auto-quarantine expired and recalled batches
    IF GVL_MedicineDB.astBatches[i].eStatus = MEDICINE_EXPIRED
       OR GVL_MedicineDB.astBatches[i].eStatus = MEDICINE_RECALLED THEN

        // Only act if not already quarantined
        IF GVL_MedicineDB.astBatches[i].eCurrentZone <> ZONE_QUARANTINE THEN
            GVL_MedicineDB.astBatches[i].eStatus      := MEDICINE_QUARANTINED;
            GVL_MedicineDB.astBatches[i].eCurrentZone := ZONE_QUARANTINE;

            // Free the physical rack slot so other batches can use it
            IF GVL_MedicineDB.astBatches[i].nRackSlot > 0
               AND GVL_MedicineDB.astBatches[i].nRackSlot <= GVL_Config.C_MAX_SLOTS THEN
                GVL_MedicineDB.astRackSlots[GVL_MedicineDB.astBatches[i].nRackSlot].bOccupied  := FALSE;
                GVL_MedicineDB.astRackSlots[GVL_MedicineDB.astBatches[i].nRackSlot].sBatchID   := '';
                GVL_MedicineDB.astRackSlots[GVL_MedicineDB.astBatches[i].nRackSlot].fCurrentWeight_kg := 0.0;
                GVL_MedicineDB.astBatches[i].nRackSlot := 0;
            END_IF

            sLastQuarantined := GVL_MedicineDB.astBatches[i].sBatchID;
            bNewQuarantine   := TRUE;
            GVL_SystemState.nTotalQuarantinedToday := GVL_SystemState.nTotalQuarantinedToday + 1;
        END_IF
    END_IF

    // Count all quarantined batches
    IF GVL_MedicineDB.astBatches[i].eStatus = MEDICINE_QUARANTINED THEN
        nQuarantineCount := nQuarantineCount + 1;
    END_IF

END_FOR

bQuarantineAlarm := (nQuarantineCount > 0);
GVL_SystemState.stAlarms.bQuarantineTriggered := bQuarantineAlarm;

IF nQuarantineCount = 0 THEN
    sStatusMessage := 'Zone D: Clear — no quarantined batches';
ELSE
    sStatusMessage := CONCAT('Zone D: ', INT_TO_STRING(nQuarantineCount));
    sStatusMessage := CONCAT(sStatusMessage, ' batch(es) in isolation');
END_IF

Execute := bNewQuarantine;]]></ST>
      </Implementation>
    </Method>
