<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.16">
  <DUT Name="E_ASRSState" Id="{26d401c9-db74-4f32-8f95-f089aa3a8805}">
    <Declaration><![CDATA[(*
  E_ASRSState
  -----------
  The current state of the ASRS crane.
  Used by FB_ASRSCrane state machine.
  Crane follows this sequence for storage:
    IDLE → MOVING_TO_SLOT → DEPOSITING → MOVING_TO_CONV → HANDING_OVER → IDLE
  For retrieval:
    IDLE → MOVING_TO_SLOT → RETRIEVING → MOVING_TO_CONV → HANDING_OVER → IDLE
*)
TYPE E_ASRSState :
(
    ASRS_IDLE               := 0,   // Crane parked at home position (0,0)
    ASRS_MOVING_TO_SLOT     := 1,   // Crane traveling to target rack slot
    ASRS_DEPOSITING         := 2,   // Crane lowering batch into slot (store)
    ASRS_RETRIEVING         := 3,   // Crane gripping batch from slot (retrieve)
    ASRS_MOVING_TO_CONV     := 4,   // Crane returning to conveyor handoff point
    ASRS_HANDING_OVER       := 5,   // Crane placing batch on output conveyor
    ASRS_FAULT              := 6    // Hardware error — manual intervention needed
);
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>